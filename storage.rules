rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // ── PROOF PHOTOS ────────────────────────────────────
    // Only the owner can upload/read/delete their own proofs.
    // No overwrite — each proof is an immutable timestamped record.
    match /proofs/{uid}/{fileName} {
      allow read:   if isOwner(uid);
      // Proofs are text-only (ProofOfActionModal) — no uploads until photo proofs come back
      allow create: if false;
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    // ── PROFILE AVATARS ─────────────────────────────────
    // Any signed-in user can read (avatars appear in the community feed).
    // Only the owner can write; overwrites are intentional (stable path).
    match /avatars/{uid}/{fileName} {
      allow read:   if isSignedIn();
      // No avatar upload in the app today — reopen (with this size/type check) when it exists
      allow write:  if false;
      allow delete: if isOwner(uid);
    }

    // ── WORKOUT ANALYSIS CLIPS ──────────────────────────────
    // Short boxing session clips for AI analysis.
    // Function deletes the file after analysis completes.
    // Client can also delete (cleanup on function error).
    match /workout-analysis/{uid}/{fileName} {
      allow read:   if isOwner(uid);
      // AI is off (FEATURES.ai) and analyzeBoxingSession isn't deployed: any signed-in account
      // could otherwise store unlimited 100 MB videos. Reopen together with the AI feature.
      allow create: if false;
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    // ── DENY EVERYTHING ELSE ───────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
